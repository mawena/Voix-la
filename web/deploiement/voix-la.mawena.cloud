# Voix-là (service web) derrière nginx : /etc/nginx/sites-available/voix-la.mawena.cloud
# DNS : CNAME voix-la → mawena.cloud.
# Puis : sudo cp deploiement/voix-la.mawena.cloud /etc/nginx/sites-available/
#        sudo ln -s ../sites-available/voix-la.mawena.cloud /etc/nginx/sites-enabled/
#        sudo nginx -t && sudo systemctl reload nginx
#        sudo certbot --nginx -d voix-la.mawena.cloud      (ajoute le HTTPS et la redirection)
server {
    listen 80;
    server_name voix-la.mawena.cloud;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8742;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_request_buffering off;   # gros envois : directement vers l'application
        client_max_body_size 310m;
    }
}
